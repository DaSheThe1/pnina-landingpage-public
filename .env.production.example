# Production values, for reference only — this file is committed, so it holds
# PLACEHOLDERS ONLY.
#
# Where the real values actually live in production:
#   NEXT_PUBLIC_*        -> .github/workflows/deploy-pages.yml (build env; public)
#   N8N_WEBHOOK_URL      -> Cloudflare Worker secret (npx wrangler secret put …)
#   N8N_WEBHOOK_SECRET   -> Cloudflare Worker secret, matching the n8n credential
#
# The static export has no server, so there is no runtime .env in production —
# the Worker holds every server-side secret. See docs/07-deployment-target.md.

NEXT_PUBLIC_SITE_URL=https://pnina.trickticmedia.com

# PUBLIC base URL of the R2 media bucket ("pnina-website"). Must be the bucket's
# public read URL (r2.dev development URL or a custom domain), NOT the
# *.r2.cloudflarestorage.com S3 API endpoint. Blank ships the bundled
# public/video copies (~11MB) from Pages instead. See docs/06-media-and-cdn.md.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.trickticmedia.com

# Per-clip overrides; normally blank.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_THANK_YOU_VIDEO_URL=
NEXT_PUBLIC_ABOUT_VIDEO_URL=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

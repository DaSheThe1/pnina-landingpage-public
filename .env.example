# Local development environment. Copy to .env.local and fill in.
# NOTHING real belongs in this file — it is committed. Real values go in
# .env.local (git-ignored) and, for production, in the deploy workflow /
# Cloudflare Worker secrets. See docs/08-security-and-privacy.md.

# The production origin. Locally you normally want http://localhost:3006 in
# .env.local instead; this is the value the Pages build uses.
NEXT_PUBLIC_SITE_URL=https://pnina.trickticmedia.com

# ── Lead delivery (server-only) ────────────────────────────────────────────
# The lead form POSTs to /api/contact, which forwards to an n8n webhook. Until
# N8N_WEBHOOK_URL is set the form returns a friendly "temporarily unavailable"
# message, so wire n8n before going live.
#
# There are two workflows, dev and prod, so local work never posts into the live
# inbox. Local dev uses the *-dev one; production uses *-prod via a Worker secret.
#
# The real URLs are in docs/10-n8n-lead-workflow.md, which is PRIVATE. They do
# not belong in this file: .env.example is committed AND mirrored to the public
# repo, and a published webhook URL is one leaked header away from an open
# lead-spam endpoint. The publish leak gate blocks on it.
N8N_WEBHOOK_URL=https://REPLACE_WITH_N8N_HOST/webhook/REPLACE_WITH_LEAD_WEBHOOK_PATH

# Shared secret sent as the `x-webhook-secret` header so a leaked webhook URL
# can't be spammed. Must match the n8n Webhook node's Header Auth credential.
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET

# Shown to the visitor as a fallback if the webhook is down.
CONTACT_TO_EMAIL=peninapearl23@gmail.com

# ── Media (Cloudflare R2 CDN) ──────────────────────────────────────────────
# PUBLIC and inlined at build time. Normally you set ONE var: the PUBLIC base URL
# of the R2 media bucket. Each clip's filename inside the bucket lives in
# `videos[key].remote` in src/content/media.ts, so this stays a single value.
#
# ⚠️ This must be the bucket's PUBLIC read URL, not its S3 API endpoint. The
# *.r2.cloudflarestorage.com address Cloudflare shows under "S3 API" needs signed
# requests and returns 401 to a browser — a <video> pointed at it plays nothing.
# Use either the r2.dev development URL (Settings → Public Development URL,
# https://pub-<id>.r2.dev) or, better, a custom domain on the bucket.
#
# Leave blank and the components fall back to the bundled /public copy, and then
# to their branded poster panel — a missing video is a supported state, not a
# broken page. See docs/06-media-and-cdn.md.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Per-clip overrides. Only needed when one video has to come from somewhere
# other than the bucket above; normally all three stay blank.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_THANK_YOU_VIDEO_URL=
NEXT_PUBLIC_ABOUT_VIDEO_URL=

# ── Analytics ──────────────────────────────────────────────────────────────
# All PUBLIC (they ship to the browser) and all OPTIONAL: leave a tracker's
# var(s) blank and that tracker is a complete no-op.
#
# ⚠️ This site's visitors are women looking for help after a sexual assault.
# Never add a tracker that records session replays, form-field contents, or
# anything that could identify an individual visitor.

# Google Analytics 4 measurement id, "G-XXXXXXXXXX" (GA4 Admin → Data Streams).
NEXT_PUBLIC_GA_ID=
# Umami (cookieless): tracker script URL + the website UUID Umami assigns.
# BOTH are required for Umami to load.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

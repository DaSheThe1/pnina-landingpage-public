# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# scratch media the client sends over WhatsApp before it is cleared for publication,
# plus the pristine originals of anything that had to be redacted and the encoded
# files waiting to be uploaded to R2. None of it belongs in git.
#
# The one exception is the upload instructions: a README that says what to put in
# the bucket and why is documentation, not media, and it is useless if it is not
# in the repo. Git cannot re-include a file whose parent DIRECTORY is excluded, so
# the exclusions have to be written per-entry rather than as `/private-media/`.
/private-media/*
!/private-media/cdn-upload/
/private-media/cdn-upload/*
!/private-media/cdn-upload/README.md


/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
# The e2e harness builds into its own directory so it cannot fight `pnpm dev`,
# and parallel agents each suffix it (`.next-e2e-heroCopy`, `.next-e2e-video`).
# Glob rather than one-off entries: two of those have already been committed by
# mistake and then added here by name after the fact.
/.next-e2e-*/
/out/

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# production
/build

# misc
.DS_Store
*.pem
*:Zone.Identifier
# ad-hoc screenshots / scratch captures (private; never part of the source tree)
Screenshot *.png
.agents/
.claude/
.codex/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# office app lock files (LibreOffice/OpenOffice)
.~lock.*#

# Local tool state and stray generation outputs (committed once by mistake, 2026-07-30)
.wrangler/
skills-lock.json
k*hf_*.png

# Stray agent probe scripts (recreated repeatedly during parallel runs)
probe-tmp.cjs
